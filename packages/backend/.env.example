# AI Provider Configuration
# Options: anthropic, openai, azure
AI_PROVIDER=anthropic

# API Keys (set one based on provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# AZURE_API_KEY=your-azure-key-here

# Model to use
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
# OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo, etc.
# Azure: Your deployment name (e.g., gpt-4, gpt-35-turbo)
AI_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI Configuration (only needed if AI_PROVIDER=azure)
# AZURE_RESOURCE_NAME=your-resource-name
# AZURE_DEPLOYMENT=your-deployment-name
# AZURE_API_VERSION=2024-02-01

# Server configuration
PORT=8080

# Agent configuration
MAX_STEPS=10

# MCP Configuration (optional)
# Path to MCP config JSON file
# MCP_CONFIG_PATH=./mcp-config.json
