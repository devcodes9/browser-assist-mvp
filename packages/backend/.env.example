# =============================================================================
# Browser Assist Backend
#
# Model configuration is per-client (BYOK) — users enter their provider/key in
# the extension's Settings panel. Nothing about provider/keys lives here UNLESS
# you also want to offer Managed (paid) mode, which is described below.
# =============================================================================

# Server
PORT=8080

# Per-run wall-clock budget (ms). Aborts runaway agents. Default 180000 (3 min).
MAX_RUN_MS=180000

# Per-task tool-call cap.
MAX_STEPS=25

# =============================================================================
# Managed mode (optional, paid tier)
# -----------------------------------------------------------------------------
# When set, users can pick from a curated model list using a license key. The
# backend supplies the API credentials so users never see them. Unset all of
# the below and only BYOK is offered.
# =============================================================================

# Comma-separated license keys the server accepts.
# MANAGED_LICENSE_KEYS=lic-abc-123,lic-xyz-456

# Provider used for managed-mode requests. anthropic | openai | azure | openai-compatible
# MANAGED_PROVIDER=anthropic
# MANAGED_API_KEY=sk-ant-...

# Only for MANAGED_PROVIDER=openai-compatible (OpenRouter, Ollama, vLLM, etc.)
# MANAGED_BASE_URL=https://openrouter.ai/api/v1

# Curated model list shown to managed users.
# Format: comma-separated "id[:label]" entries. Label optional.
# MANAGED_MODELS=claude-3-5-sonnet-20241022:Claude 3.5 Sonnet,claude-opus-4:Claude Opus 4

# Azure-only (when MANAGED_PROVIDER=azure)
# AZURE_RESOURCE_NAME=your-resource
# AZURE_DEPLOYMENT=your-deployment
# AZURE_API_VERSION=2024-02-01

# =============================================================================
# MCP (optional)
# =============================================================================
# MCP_CONFIG_PATH=./mcp-config.json
